node_modules/
.next/
.env.local
.DS_Store

# BE-21 — a benchmark run's own generated output, never a committed
# artifact; see ops/benchmark/run.js.
ops/benchmark/output/
ops/browser/output/

# BE-43 (#101) — a filtered browser run (`--alleen`) writes its own record and
# must never replace the full evidence file that belongs with the delivery.
ops/browser/evidence/*.filtered.json

# BE-50 (#120) — the local logs of the perf measurement (next build/next start);
# the measurement itself is committed in ops/perf/evidence/.
ops/perf/output/

# BE-50 (#120) — logs of a local run belong outside git. The evidence that does
# belong to the delivery stays in ops/browser/evidence/ and ops/perf/evidence/.
/*.log

