# Supabase project credentials (PLATFORM-05).
#
# This file documents the expected variable names only — no real values.
# Copy it to .env.local (already gitignored, never commit real values
# there either) and fill in the values from your Supabase project
# (Project Settings -> API).

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key. Full database access, bypasses Row Level Security.
# Server-only — used exclusively by src/lib/supabaseAdmin.js. Never expose
# this to the client, never commit it, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side config (PLATFORM-06). NEXT_PUBLIC_ variables are bundled into
# the browser JS by Next.js on purpose — these two are designed to be
# public and safe there. Used only for Supabase Auth session/login in
# src/lib/supabaseBrowser.js; never for direct data access. Whichever your
# project's dashboard shows under Project Settings -> API — "anon" (legacy
# key format) or "publishable" (newer format) — both work identically here.

# Same project URL as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key — NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
